{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillify.local/evals/schema.json",
  "title": "Skillify behavioral evaluation suite",
  "type": "object",
  "required": ["schemaVersion", "skill", "cases"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "skill": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "category", "prompt", "expected"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "category": {
            "enum": ["activation", "routing", "selection", "contract", "boundary", "handoff", "integration"]
          },
          "prompt": { "type": "string", "minLength": 10 },
          "context": { "type": "array", "items": { "type": "string" } },
          "expected": {
            "type": "object",
            "required": ["invocation", "behaviors", "forbidden"],
            "additionalProperties": false,
            "properties": {
              "invocation": { "enum": ["required", "forbidden"] },
              "weight": { "enum": ["Light", "Standard", "Heavy"] },
              "verbosity": { "enum": ["Terse", "Concise", "Detailed"] },
              "explanation": { "enum": ["Layman", "Operational", "Expert"] },
              "choiceCard": { "enum": ["required", "optional", "forbidden"] },
              "customization": {
                "type": "object",
                "required": ["weight", "verbosity", "explanation", "ownership"],
                "additionalProperties": false,
                "properties": {
                  "weight": { "enum": ["Light", "Standard", "Heavy"] },
                  "verbosity": { "enum": ["Terse", "Concise", "Detailed"] },
                  "explanation": { "enum": ["Layman", "Operational", "Expert"] },
                  "ownership": { "enum": ["Solo", "Team", "Custom team"] },
                  "roles": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 },
                    "uniqueItems": true
                  }
                },
                "allOf": [
                  {
                    "if": { "properties": { "ownership": { "const": "Custom team" } } },
                    "then": { "required": ["roles"] }
                  },
                  {
                    "if": { "properties": { "ownership": { "enum": ["Solo", "Team"] } } },
                    "then": { "not": { "required": ["roles"] } }
                  }
                ]
              },
              "topology": { "enum": ["solo", "delegated"] },
              "mode": { "type": "string", "minLength": 1 },
              "references": { "type": "array", "items": { "type": "string" } },
              "behaviors": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "forbidden": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
