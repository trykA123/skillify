{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillify.local/evals/schema.json",
  "title": "Skillify behavioral evaluation suite",
  "type": "object",
  "required": ["schemaVersion", "skill", "cases"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "skill": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "category", "prompt", "expected"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "category": {
            "enum": ["activation", "routing", "contract", "boundary", "handoff"]
          },
          "prompt": { "type": "string", "minLength": 10 },
          "context": { "type": "array", "items": { "type": "string" } },
          "expected": {
            "type": "object",
            "required": ["invocation", "behaviors", "forbidden"],
            "additionalProperties": false,
            "properties": {
              "invocation": { "enum": ["required", "forbidden"] },
              "weight": { "enum": ["Light", "Standard", "Heavy"] },
              "mode": { "type": "string", "minLength": 1 },
              "references": { "type": "array", "items": { "type": "string" } },
              "behaviors": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "forbidden": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
