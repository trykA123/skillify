{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillify.local/evals/agents/schema.json",
  "title": "Skillify fleet behavioral evaluation suite",
  "type": "object",
  "required": ["schemaVersion", "subject", "cases"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "subject": { "const": "fleet" },
    "cases": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "category", "prompt", "expected"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "category": {
            "enum": ["selection", "authority", "handoff", "topology", "communication", "capability"]
          },
          "prompt": { "type": "string", "minLength": 10 },
          "expected": {
            "type": "object",
            "required": ["role", "behaviors", "forbidden"],
            "additionalProperties": false,
            "properties": {
              "role": { "type": "string", "minLength": 1 },
              "weight": { "enum": ["Light", "Standard", "Heavy"] },
              "verbosity": { "enum": ["Terse", "Concise", "Detailed"] },
              "explanation": { "enum": ["Expert", "Operational", "Teaching"] },
              "behaviors": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "forbidden": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
